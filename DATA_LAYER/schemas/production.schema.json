{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Production Data",
  "type": "object",
  "required": ["meta", "data"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["extracted_at", "source", "period"],
      "properties": {
        "extracted_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "examples": ["MES", "Xunyue"] },
        "period": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "overall_oee_pct": { "type": "number" },
        "availability_pct": { "type": "number" },
        "performance_pct": { "type": "number" },
        "quality_pct": { "type": "number" },
        "completion_pct": { "type": "number" },
        "by_machine": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "machine_id": { "type": "string" },
              "line": { "type": "string" },
              "family": { "type": "string" },
              "oee_pct": { "type": "number" },
              "output_units": { "type": "integer" },
              "downtime_hours": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
